APP_NAME=NodeCraft API
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed CORS origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite by default. Swap for a Postgres URL in production, e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/nodecraft
DATABASE_URL=sqlite:///./nodecraft.db

# JWT auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
